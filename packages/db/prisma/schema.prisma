// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String   @id  @default(uuid())
  email String   @unique
  password String

  memberships Membership[]
  issueMappings IssueMapping[]
  invitations Invitation[]
}

model Org {
  id    String     @id   @default(uuid())
  name  String
  description String

  memberships Membership[]
  boards Board[]
  invitations Invitation[]
}

enum InvitationStatus {
  ACCEPTED
  PENDING
  REJECTED
}

model Invitation {
  id String @id @default(uuid())
  email     String
  role      MembershipRole @default(member)
  status    InvitationStatus @default(PENDING)
  
  orgId     String
  org       Org @relation(fields: [orgId], references: [id], onDelete: Restrict)
  
  userId String
  user   User @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  @@unique([email, orgId])
}

enum MembershipRole {
  member
  admin
}

model Membership {
  id    String    @id    @default(uuid())
  userId String
  orgId String
  role MembershipRole  

  user User @relation(fields: [userId], references: [id])
  org Org @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([userId, orgId])
}

model Issue {
  id    String    @id   @default(uuid())
  title String 
  description String
  boardId String
  sectionId String

  board Board @relation(fields: [boardId], references: [id], onDelete: Restrict)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  comments Comment[]
  issueMappings IssueMapping[]
}

model Board {
  id String @id @default(uuid())
  title String
  orgId String

  org Org @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sections Section[]
  issues Issue[]
}

model Section {
  id    String    @id   @default(uuid())
  title String
  boardId String

  board Board @relation(fields: [boardId], references: [id], onDelete: Restrict)

  issues Issue[]
}

model Comment {
  id String     @id     @default(uuid())
  issueId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
}

model IssueMapping {
  id    String    @id    @default(uuid())
  userId String
  issueId String

  user User @relation(fields: [userId], references: [id])
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
}